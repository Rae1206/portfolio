---
/**
 * Retro terminal window with traffic-light dots and an optional title.
 */
interface Props {
  title?: string;
  tone?: 'lavender' | 'sage';
  class?: string;
}

const { title, tone = 'lavender', class: className } = Astro.props;
---

<div class:list={['window', `window--${tone}`, className]}>
  <div class="window__bar">
    <span class="window__dots" aria-hidden="true">
      <span></span><span></span><span></span>
    </span>
    {title && <span class="window__title">{title}</span>}
  </div>
  <div class="window__body">
    <slot />
  </div>
</div>

<style>
  .window {
    --window-color: var(--color-purple);
    position: relative;
    border: 1px solid color-mix(in srgb, var(--window-color) 55%, transparent);
    border-radius: 6px;
    background: rgb(9 9 7 / 0.82);
    backdrop-filter: blur(3px);
    box-shadow:
      0 0 0 4px rgb(0 0 0 / 0.35),
      0 0 40px -20px var(--window-color);
  }

  .window--sage {
    --window-color: var(--color-sage);
  }

  .window__bar {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-2) var(--space-4);
    border-bottom: 1px dashed color-mix(in srgb, var(--window-color) 40%, transparent);
  }

  .window__dots {
    display: inline-flex;
    gap: 6px;
  }

  .window__dots span {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    border: 1.5px solid var(--color-purple);
  }

  .window__dots span:nth-child(2) { border-color: var(--color-amber); }
  .window__dots span:nth-child(3) { border-color: var(--color-sage); }

  .window__title {
    font-size: var(--text-xs);
    color: var(--color-ink-muted);
    letter-spacing: 0.06em;
  }

  .window__body {
    padding: var(--space-4) var(--space-6);
    font-size: var(--text-sm);
  }
</style>
