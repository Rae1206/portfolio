---
/**
 * Text progress bar, e.g. [████████░░░░] 72%. Fills in when revealed.
 */
interface Props {
  label: string;
  value: number;
  segments?: number;
}

const { label, value, segments = 16 } = Astro.props;
const filled = Math.round(Math.min(1, Math.max(0, value)) * segments);
const percent = Math.round(value * 100);
---

<div class="meter" role="meter" aria-label={label} aria-valuemin="0" aria-valuemax="100" aria-valuenow={percent}>
  <span class="meter__label">{label}</span>
  <span class="meter__bar" aria-hidden="true" data-reveal="clip">
    [<span class="meter__fill">{'█'.repeat(filled)}</span><span class="meter__empty">{'░'.repeat(segments - filled)}</span>]
  </span>
  <span class="meter__value">{percent}%</span>
</div>

<style>
  .meter {
    display: grid;
    grid-template-columns: minmax(8rem, 1fr) auto 3.5ch;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--text-sm);
  }

  .meter__label {
    color: var(--color-ink);
  }

  .meter__bar {
    color: var(--color-ink-faint);
    letter-spacing: -0.05em;
    white-space: nowrap;
  }

  .meter__fill {
    color: var(--color-sage);
  }

  .meter__empty {
    color: var(--color-ink-faint);
  }

  .meter__value {
    color: var(--color-lavender);
    text-align: right;
  }

  @media (max-width: 520px) {
    .meter {
      grid-template-columns: 1fr 3.5ch;
    }

    .meter__bar {
      grid-column: 1 / -1;
      grid-row: 2;
    }
  }
</style>
