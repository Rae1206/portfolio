---
import ProjectCard from '@/components/cards/ProjectCard.astro';
import Carousel from '@/components/ui/Carousel.astro';
import Section from '@/components/ui/Section.astro';
import { asciiArtNames } from '@/data/ascii-art';
import { projects } from '@/data/portfolio';
---

<Section id="projects" index="03" command="ls -la ./projects" title="Selected work" kicker="Things I planted and watched grow.">
  <Carousel label="Projects">
    {
      projects.map((project, index) => (
        <li>
          <ProjectCard project={project} index={index} art={asciiArtNames[index % asciiArtNames.length]!} />
        </li>
      ))
    }
  </Carousel>
</Section>
