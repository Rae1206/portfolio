---
import AsciiGarden from '@/components/islands/AsciiGarden';
import AsciiMorph from '@/components/ui/AsciiMorph.astro';
import Divider from '@/components/ui/Divider.astro';
import Icon from '@/components/ui/Icon.astro';
import { monogram, monogramFlower } from '@/data/monogram';
import { navItems, profile } from '@/data/site';
---

<aside class="sidebar">
  <div class="sidebar__emblem">
    <AsciiMorph from={monogram} to={monogramFlower} label="AAAT monogram" />
  </div>

  <nav class="sidebar__nav" aria-label="Sections">
    <ul>
      {
        navItems.map((item, index) => (
          <li>
            <a href={`#${item.id}`} class="sidebar__link" data-nav-link={item.id} aria-current={index === 0 ? 'true' : undefined}>
              <span class="sidebar__marker" aria-hidden="true">
                <span class="sidebar__marker-idle"><Icon name="sparkle" size={10} /></span>
                <span class="sidebar__marker-active">&gt;</span>
              </span>
              <span class="sidebar__icon" aria-hidden="true"><Icon name={item.icon} size={18} /></span>
              <span class="sidebar__label">{item.label}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <div class="sidebar__extras">
    <Divider />
    <p class="sidebar__motto">
      {profile.motto.map((word) => <span>{word}</span>)}
    </p>
  </div>

  <div class="sidebar__garden">
    <AsciiGarden client:idle preset="sidebar" fontSize={9} className="sidebar__garden-canvas" />
  </div>
</aside>

<style>
  .sidebar {
    position: sticky;
    top: calc(var(--topbar-height) + var(--space-4));
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    height: calc(100dvh - var(--topbar-height) - var(--space-8));
    padding: var(--space-4) var(--space-3) 0;
    border: 1px dashed var(--color-border);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .sidebar__emblem {
    --ascii-size: 0.45rem;
    display: flex;
    justify-content: center;
    padding-top: var(--space-2);
  }

  .sidebar__garden :global(.sidebar__garden-canvas) {
    width: 100%;
    height: 100%;
  }

  .sidebar__nav ul {
    display: grid;
    gap: var(--space-1);
  }

  .sidebar__link {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-1) var(--space-2);
    border: 1px solid transparent;
    border-radius: 2px;
    font-size: var(--text-sm);
    color: var(--color-ink);
    transition:
      color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out),
      background var(--duration-fast) var(--ease-out);
  }

  .sidebar__link:hover {
    color: var(--color-lavender);
  }

  .sidebar__link[aria-current='true'] {
    border-color: var(--color-purple);
    color: var(--color-lavender);
    background: rgb(160 102 221 / 0.08);
  }

  .sidebar__icon {
    display: none;
  }

  .sidebar__marker {
    display: inline-grid;
    width: 0.8rem;
    color: var(--color-lavender);
  }

  .sidebar__marker > span {
    grid-area: 1 / 1;
    transition: opacity var(--duration-fast);
  }

  .sidebar__marker-active {
    opacity: 0;
    color: var(--color-lavender);
  }

  .sidebar__link[aria-current='true'] .sidebar__marker-active {
    opacity: 1;
  }

  .sidebar__link[aria-current='true'] .sidebar__marker-idle {
    opacity: 0;
  }

  .sidebar__extras {
    display: grid;
    gap: var(--space-6);
  }

  .sidebar__motto {
    display: grid;
    padding-left: var(--space-3);
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--color-lavender);
  }

  .sidebar__garden {
    flex: 1;
    min-height: 10rem;
    margin-inline: calc(var(--space-3) * -1);
  }

  /* Compact horizontal nav on small screens */
  @media (max-width: 960px) {
    .sidebar {
      top: var(--topbar-height);
      z-index: 40;
      flex-direction: row;
      align-items: center;
      height: auto;
      padding: var(--space-2) var(--space-3);
      border-inline: 0;
      border-top: 0;
      border-radius: 0;
      background: rgb(11 11 9 / 0.9);
      backdrop-filter: blur(6px);
    }

    .sidebar__emblem,
    .sidebar__extras,
    .sidebar__garden {
      display: none;
    }

    .sidebar__nav {
      flex: 1;
    }

    /* Icons only: the labels stay for screen readers */
    .sidebar__nav ul {
      display: flex;
      justify-content: space-between;
    }

    .sidebar__link {
      justify-content: center;
      padding: var(--space-2);
    }

    .sidebar__marker {
      display: none;
    }

    .sidebar__icon {
      display: inline-flex;
    }

    .sidebar__label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }
  }
</style>
