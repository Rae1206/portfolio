---
import { profile } from '@/data/site';

const year = new Date().getFullYear();
const owner = `${profile.firstName} ${profile.lastName}`;
---

<footer class="footer">
  <p>
    <span class="text-muted">©</span>
    {`${year} ${owner}`}
    <span class="footer__sep" aria-hidden="true">·</span>
    <span class="text-muted">grown with</span> Astro, React <span class="text-muted">&amp;</span> Three.js
  </p>
  <a href="#home" class="footer__top">cd ~ <span aria-hidden="true">↑</span></a>
</footer>

<style>
  .footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-6) clamp(var(--space-4), 5vw, var(--space-16));
    border-top: 1px dashed var(--color-border);
    font-size: var(--text-xs);
    color: var(--color-ink);
  }

  .footer__sep {
    margin-inline: var(--space-2);
    color: var(--color-purple);
  }

  .footer__top {
    color: var(--color-sage);
  }

  .footer__top:hover {
    color: var(--color-lavender);
  }
</style>
